<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>InspireTel.SipProbe.Mac</RootNamespace>
    <AssemblyName>InspireTel.SIPProbe</AssemblyName>
    <Product>InspireTel SIP Probe</Product>
    <Description>Portable SIP registration and network diagnostic utility.</Description>
    <Company>InspireTel</Company>
    <Version>1.4.0</Version>
    <ApplicationId>za.co.inspiretel.sipprobe</ApplicationId>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <PublishTrimmed>false</PublishTrimmed>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.4" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SipProbe.Core/SipProbe.Core.csproj" />
  </ItemGroup>
</Project>
